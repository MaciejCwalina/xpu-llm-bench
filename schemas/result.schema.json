    "DecodeMethod": {
      "properties": {
        "counters": {
          "items": {
            "type": "string"
          },
          "title": "Counters",
          "type": "array"
        },
        "formula": {
          "default": "Per session: window = first token -> last token of a fixed max_tokens output (ignore_eos). delivered E_i = tokens after the first (the first is the prefill step); verify steps S_i = token-bearing SSE chunks after the first (one chunk per engine step). decode tok/s = E_i / window; steps/s = S_i / window. true hit rate = (E - S) / (k * S) with E, S summed over sessions; S_server = delta(spec_decode_num_drafts_total) cross-checks S (STEP_COUNT_MISMATCH > 5%). accepted_drafts_per_step = E/S - 1 (from the stream); acceptance_rate_vllm = A/T is kept for continuity only.",
          "title": "Formula",
          "type": "string"
        },
        "method_id": {
          "default": "fixed-tokens-chunks-v2",
          "title": "Method Id",
          "type": "string"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        },
        "window": {
          "default": "fixed_output_tokens",
          "title": "Window",
          "type": "string"
        }
      },
      "required": [
        "output_tokens"
      ],
      "title": "DecodeMethod",
      "type": "object"
    },
